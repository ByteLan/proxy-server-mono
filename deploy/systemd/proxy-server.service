[Unit]
Description=Proxy node agent and protocol supervisors
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxy-node
Group=proxy-node
EnvironmentFile=/etc/proxy-server/node.env
ExecStart=/opt/proxy-server/bin/proxy-server run --config /etc/proxy-server/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/proxy-server
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
